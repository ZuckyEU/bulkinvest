# Copy to .env for local development.

# Auth.js / NextAuth (sessions)
# NEXTAUTH_URL is the app's canonical origin; NEXTAUTH_SECRET signs the session JWT.
# Generate a secret with any of:
#   npx auth secret          (Auth.js CLI)
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# SQLite database file lives next to the schema in prisma/.
DATABASE_URL="file:./dev.db"

# Payments (Stripe test mode).
# Leave STRIPE_SECRET_KEY blank to disable card checkout.
# Test keys: https://dashboard.stripe.com/test/apikeys  (sk_test_...)
STRIPE_SECRET_KEY=""
# From `stripe listen` or the endpoint's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# Currency deposits are charged in ("usd", "ngn", "eur", "gbp", ...).
DEPOSIT_CURRENCY="usd"

# Alpaca trading (source of truth for cash, positions and order execution).
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
# ALPACA_PAPER="true" for testing (paper-api.alpaca.markets), "false" for live.
ALPACA_PAPER="true"

# Crypto deposits (crypto payment gateway — NOWPayments).
# Get keys at https://account.nowpayments.io/ (sandbox: https://account-sandbox.nowpayments.io/)
CRYPTO_PAYMENT_API_KEY=""
# Webhook secret used to verify the x-nowpayments-sig HMAC on deposit callbacks.
CRYPTO_PAYMENT_WEBHOOK_SECRET=""
# "true" targets the gateway sandbox (no real funds). Use "false" for live.
CRYPTO_PAYMENT_SANDBOX="true"

# Stock quote provider (see src/lib/stocks.ts)
# Use ONE of these. Finnhub is preferred (free tier: 60 req/min).
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=""

# Alpha Vantage fallback (free tier: 25 req/day)
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=""

# Optional: force a provider when both keys are set ("finnhub" | "alphavantage")
# STOCK_API_PROVIDER="finnhub"
